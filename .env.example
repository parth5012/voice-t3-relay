# Voice-to-T3 Relay Configuration

PORT=8799
# Your Tailscale MagicDNS node hostname (e.g. debian.tail46d59a.ts.net)
TAILSCALE_HOST=debian.tail46d59a.ts.net
# Optional overrides:
# PUBLIC_BASE_URL=https://debian.tail46d59a.ts.net/voice-relay
# T3_WEB_URL=https://debian.tail46d59a.ts.net

# ntfy configuration for push notifications & action cards
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=t3-voice-thought

# Groq Cloud API for instant speech-to-text (~200ms)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo

# T3 Model defaults
DEFAULT_PROVIDER=antigravity
DEFAULT_MODEL=gemini-3.8-flash

# Directories
PROJECTS_ROOT=~/projects
SCRATCH_DIR=~/.t3/scratch
DATA_DIR=~/.local/share/voice-t3-relay
